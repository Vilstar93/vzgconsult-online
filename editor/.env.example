# VZG Editor – Konfiguration
# Diese Datei wird NICHT in Git eingecheckt (siehe .gitignore).

# Passwort für den Editor (Login: Benutzer "vzg").
EDITOR_PASSWORD=

# GitHub-Token mit Schreibrecht, damit "Veröffentlichen" pushen kann.
# Fine-grained PAT: Repository "vzgconsult-online", Contents = Read and write.
GIT_PUSH_TOKEN=

# Ziel-Branch (Standard: main)
GIT_BRANCH=main
