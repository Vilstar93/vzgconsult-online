doctype html
html(lang='de')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='robots', content='noindex, nofollow')
        meta(name='author', content='VZG Consult')

        title Download – VZG Consult

        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css

    body

        include includes/header

        include includes/navbar

        section.page-section
            .container
                .row
                    .col-lg-8.mx-auto
                        #downloadBox.bg-faded.rounded.p-5.text-center
                            h1.section-heading.mb-4
                                span.section-heading-upper Vielen Dank für Ihren Kauf
                                span.section-heading-lower Ihr Energie-Ratgeber
                            #downloadLoading
                                p.mb-0.text-muted
                                    | Ihre Zahlung wird geprüft – einen Moment bitte …
                            #downloadReady.d-none
                                p.mb-4
                                    | Ihre Zahlung wurde bestätigt. Klicken Sie auf den Button, um den Ratgeber als PDF herunterzuladen.
                                a#downloadLink.btn.btn-primary.btn-xl(href='#', rel='noopener') PDF herunterladen
                                p.small.text-muted.mt-4.mb-0
                                    | Der Download-Link ist 24 Stunden gültig. Bei Problemen erreichen Sie uns unter&nbsp;
                                    a(href='mailto:info@vzgconsult.online') info@vzgconsult.online
                                    | .
                            #downloadError.d-none
                                .alert.alert-warning.mb-4(role='alert')
                                    | Der Download konnte nicht bereitgestellt werden. Bitte prüfen Sie den Link aus Ihrer Bestätigungs-E-Mail oder kontaktieren Sie uns.
                                a.btn.btn-outline-secondary(href='kontakt.html') Kontakt aufnehmen

        include includes/footer

        include includes/scripts
