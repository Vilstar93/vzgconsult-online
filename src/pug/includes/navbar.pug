// Navigation
nav#mainNav.navbar.navbar-expand-lg.navbar-dark.py-lg-4
    .container
        a.navbar-brand.text-uppercase.fw-bold.d-lg-none(href='index.html')
            span.text-primary VZG
            |  Consult
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarSupportedContent', aria-controls='navbarSupportedContent', aria-expanded='false', aria-label='Navigation umschalten')
            span.navbar-toggler-icon
        #navbarSupportedContent.collapse.navbar-collapse
            ul.navbar-nav.mx-auto
                li.nav-item.px-lg-3
                    a.nav-link.text-uppercase(href='index.html') Startseite
                li.nav-item.px-lg-3
                    a.nav-link.text-uppercase(href='leistungen.html') Leistungen
                li.nav-item.px-lg-3
                    a.nav-link.text-uppercase(href='preise.html') Preise
                li.nav-item.px-lg-3
                    a.nav-link.text-uppercase(href='ratgeber.html') Ratgeber
                li.nav-item.px-lg-3
                    a.nav-link.text-uppercase(href='ueber-uns.html') Über uns
                li.nav-item.px-lg-3
                    a.nav-link.text-uppercase(href='kontakt.html') Kontakt
                li.nav-item.px-lg-3
                    a.btn.btn-primary.btn-sm.mt-2.mt-lg-0.nav-booking(href='termin.html') Termin buchen
        .lang-switcher.ms-lg-3.mt-2.mt-lg-0(role='group', aria-label='Sprache wählen')
            button.lang-btn(type='button', data-lang-set='de', aria-pressed='true') DE
            button.lang-btn(type='button', data-lang-set='bg', aria-pressed='false') BG
